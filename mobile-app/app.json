{
  "expo": {
    "name": "VanGo",
    "slug": "mobile",
    "version": "1.0.22",
    "orientation": "portrait",
    "icon": "./assets/Frame1.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/Frame1.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "updates": {
      "enabled": false
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "buildNumber": "22",
      "config": {
        "googleMapsApiKey": "AIzaSyAy2PBVzeFza_-MnitqOWmzPVB6RzaGTYc"
      },
      "infoPlist": {
        "NSCameraUsageDescription": "VanGo використовує камеру, щоб ви могли фотографувати вантаж для замовлення та під час доставки, додавати фото профілю, документів і автомобіля водія або фото до звернення в підтримку. Наприклад, зробіть фото вантажу під час завантаження.",
        "NSPhotoLibraryUsageDescription": "VanGo надає змогу вибирати фото з фотобібліотеки для замовлень, профілю, документів і автомобіля водія та звернень у підтримку. Наприклад, виберіть фото вантажу, щоб додати його до замовлення.",
        "NSLocationWhenInUseUsageDescription": "Доступ до геолокації потрібен, щоб показати ваше місце на карті та підібрати адреси поруч",
        "GMSApiKey": "AIzaSyAy2PBVzeFza_-MnitqOWmzPVB6RzaGTYc",
        "ITSAppUsesNonExemptEncryption": false,
        "LSApplicationQueriesSchemes": [
          "comgooglemaps",
          "waze"
        ]
      },
      "bundleIdentifier": "com.pashagr.mobile"
    },
    "android": {
      "versionCode": 22,
      "usesCleartextTraffic": true,
      "defaultChannel": "orders_v2",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyA8Gs9cDcKHTrC83D_GaBVeP2yCfA_Doxs"
        }
      },
      "adaptiveIcon": {
        "foregroundImage": "./assets/Frame1.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "softwareKeyboardLayoutMode": "resize",
      "package": "com.pashagr.mobile",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "googlePlacesApiKey": "AIzaSyA8Gs9cDcKHTrC83D_GaBVeP2yCfA_Doxs",
      "eas": {
        "projectId": "4e30dc6f-5208-49d8-b7fc-811652df312b"
      }
    },
    "owner": "ba-group",
    "plugins": [
      "@react-native-community/datetimepicker",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#2A8F57",
          "sounds": [
            "./assets/sounds/notification_sound.mp3"
          ]
        }
      ]
    ]
  }
}
